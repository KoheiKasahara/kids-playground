{
  "name": "kids-playground",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:earth-globe-data": "node scripts/build-earth-globe-data.mjs",
    "build:earth-globe-countries": "node scripts/build-earth-globe-countries.mjs",
    "preview": "vite preview",
    "lint": "eslint . && npm run test:boundaries && npm run check:boundaries",
    "check:boundaries": "node scripts/architecture/check-boundaries.mjs",
    "test:boundaries": "node --test scripts/architecture/check-boundaries.test.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:quick": "vitest run --project unit --project dom",
    "test:full": "vitest run",
    "test:slow": "vitest run --project slow",
    "test:game": "vitest run",
    "test:watch": "vitest --project unit --project dom",
    "test:e2e": "playwright test e2e/initial-html.smoke.spec.ts e2e/flag-roll-puzzle.smoke.spec.ts e2e/draw-goal.smoke.spec.ts e2e/magic-sandbox.smoke.spec.ts e2e/pixel-kart.smoke.spec.ts e2e/project-health.smoke.spec.ts e2e/quiz-lazy-loading.smoke.spec.ts",
    "test:e2e:nightly": "playwright test --workers=1",
    "verify": "npm run lint && npm run typecheck && npm run test:quick && npm run build",
    "verify:full": "npm run lint && npm run typecheck && npm run test:full && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "matter-js": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "three-globe": "^2.45.6",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "flag-icons": "^7.6.0",
    "globals": "^17.13.0",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.5"
  }
}
